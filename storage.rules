rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function self(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/roles/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/roles/$(request.auth.uid)).data.admin == true;
    }
    function picture() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    match /member-media/{uid}/{file} {
      allow read: if true;
      allow create: if self(uid) && picture();
      allow update: if false;
      allow delete: if self(uid) || admin();
    }
    match /site-media/{uid}/{file} {
      allow read: if true;
      allow create: if self(uid) && admin() && picture();
      allow update: if false;
      allow delete: if admin();
    }
    // Legacy pictures remain viewable, but new uploads use the protected paths.
    match /profile-images/{uid}/{file} { allow read: if true; allow write: if false; }
    match /vehicle-images/{uid}/{file} { allow read: if true; allow write: if false; }
    match /store-images/{file} { allow read: if true; allow write: if false; }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
